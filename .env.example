# =============================================================================
# openagent-code - environment variables (example)
# =============================================================================
#
# Copy this file to `.env` and fill in real values BEFORE running the agent.
# NEVER commit `.env`.
#
#     cp .env.example .env
#     # then edit .env
#
# Every variable name here matches the os.environ.get() calls in src/config.py
# and the ENV defaults in docker/code/Dockerfile. Every value has a default in
# src/config.py if left unset, except the model endpoint, which you must point
# at your own provider.
# =============================================================================


# -----------------------------------------------------------------------------
# Model gateway — the swappable boundary                          (src/config.py)
# -----------------------------------------------------------------------------
#
# CODE_MODEL is the LiteLLM model string. CODE_API_BASE is the OpenAI-compatible
# endpoint URL. Switching providers is an edit HERE, never a code change.
#
#   Self-hosted vLLM / RunPod (gpt-oss-120b):
#     CODE_MODEL=openai/gpt-oss-120b
#     CODE_API_BASE=https://<your-pod>-8000.proxy.runpod.net/v1
#
#   Together (OpenAI-compatible; thinkingmachines/Inkling):
#     CODE_MODEL=openai/thinkingmachines/Inkling
#     CODE_API_BASE=https://api.together.xyz/v1
#     CODE_API_KEY=<your together key>
#
#   Thinking Machines Lab / Tinker (OpenAI-compatible; the CURRENT deployment — Inkling-Small, 256k window).
#   Native tool-calling + streaming confirmed. Tinker defaults separate_reasoning=true, so reasoning_content
#   comes back on its own (no CODE_EXTRA_BODY needed). reasoning_effort accepts low..xhigh (xhigh = 0.99 =
#   max). Use your sampler-weights URI or the base model id. Warmup is pointless on this managed endpoint:
#     CODE_MODEL=openai/thinkingmachines/Inkling-Small:peft:262144
#     CODE_API_BASE=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
#     CODE_API_KEY=<your tinker key>
#
#   --- DISTILLATION PROFILES (specs/0005) ---
#
#   TEACHER — gpt-oss-120b on AWS Bedrock via boto3 / IAM (no cold starts, 128k ctx).
#   Leave CODE_API_BASE EMPTY; auth comes from the AWS_* vars (or an IAM role / SSO).
#   reasoning_effort is sent provider-aware (top-level for bedrock/) — set it HIGH:
#     CODE_MODEL=bedrock/openai.gpt-oss-120b-1:0
#     CODE_API_BASE=
#     CODE_API_KEY=
#     CODE_REASONING_EFFORT=high
#
#   STUDENT — your distilled model, served LOCALLY on vLLM (the `serve` compose service,
#   --served-model-name student). The Stage-6 swap back into the agent is THESE lines;
#   everything else stays the boundary. (Use CODE_TOOL_MODE=json if you serve without a
#   native tool-call parser.)
#     CODE_MODEL=openai/student
#     CODE_API_BASE=http://localhost:8000/v1
#     CODE_API_KEY=EMPTY

CODE_MODEL=openai/thinkingmachines/Inkling-Small:peft:262144
CODE_API_BASE=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1

# Key for the endpoint. For self-hosted vLLM this is the value passed to
# --api-key (or "EMPTY" if none was set). Leave as-is for Bedrock and set the
# AWS_* vars instead.
CODE_API_KEY=EMPTY

# Sampling temperature for the agent loop. Lower = more deterministic edits.
CODE_TEMPERATURE=0.2

# gpt-oss reasoning depth: low | medium | high (sent as reasoning_effort). Higher =
# the model deliberates more before answering — helps a weaker model (e.g. 20b) actually
# investigate / call tools instead of confabulating. Empty = use the endpoint default.
CODE_REASONING_EFFORT=
# Reasoning pass-through (specs/0044) — finer control than low/medium/high, for a model with several
# reasoning layers (Inkling). CODE_REASONING_VALUE empty (default) = OFF, the effort knob above is used
# (byte-identical). When set, the request gets {CODE_REASONING_PARAM: <value>}: the value is JSON-parsed if
# it parses (int budget 2048, or an object {"type":"enabled","budget_tokens":2048}), else a literal string
# (xhigh). Routed via extra_body unless CODE_REASONING_TOPLEVEL=true (or a bedrock/ model). A per-subagent
# effort (grounding/guardian) always keeps the legacy path. Leave VALUE empty until Inkling's real
# reasoning parameter is confirmed — an unaccepted value would 400 the request (and the warm-up probe).
CODE_REASONING_PARAM=reasoning_effort
CODE_REASONING_VALUE=
CODE_REASONING_TOPLEVEL=false
# Extra request params (specs/0049) — a JSON object merged into the request's extra_body, so you can send
# WHATEVER an OpenAI-compatible endpoint accepts alongside the reasoning knob, no code change (the single-key
# reasoning pass-through above cannot send two extra_body keys at once). E.g. for Tinker/Inkling-small:
#   CODE_EXTRA_BODY={"separate_reasoning": true}
# Default empty = nothing merged (byte-identical). Non-object / bad JSON -> ignored. A key collision with the
# reasoning knob resolves in the reasoning knob's favor.
CODE_EXTRA_BODY=

# --- agent identity (Phase 36 / specs/0036) ---
# The user-facing NAME the agent answers to (its system-prompt identity line + the two banners). Default
# "OAC". The package / import name stays openagent-code; only the display identity changes. Manage these with
# `openagent-code --set-name <name> [--persona "..."]` (writes them + drops a launcher) and `--remove-name`
# (reverts to OAC). A blank value falls back to OAC. CODE_AGENT_PERSONA is an OPTIONAL one-line personality
# appended to the system prompt; empty appends nothing.
CODE_AGENT_NAME=OAC
CODE_AGENT_PERSONA=
# Structured identity block (Phase 63 / specs/0063), default OFF. Some base models ship a strong trained-in
# identity contract (a <model_information> block + "answer consistently with the above" directive) that a soft
# "You are <name>" line loses to. When on, we inject a <model_information> block for THIS agent in that same
# format, so it reports YOUR identity, never the base model/provider. Fill the fields (empty ones are omitted):
CODE_AGENT_IDENTITY_BLOCK=false
CODE_AGENT_OVERVIEW=
CODE_AGENT_CREATOR=
CODE_AGENT_CONTEXT=

# Retry transient model failures (connection/timeout/5xx) and dropped tool calls
# (empty response from a worker missing the tool-call parser), with backoff. Makes
# a flaky / intermittent endpoint usable. 0 = no retries. Bump it (e.g. 6) for
# serverless Bedrock, which throws bursts of transient 503s on large requests.
CODE_MODEL_RETRIES=5
# Max seconds for one retry's exponential backoff (jitter added on top). Higher lets
# retries ride out a Bedrock 503 burst instead of giving up at a flat low cap.
CODE_BACKOFF_CAP=20

# --- cold starts (scale-to-zero serverless) ---
# Read timeout (seconds) for a single model call. Generous on purpose: a
# scale-to-zero worker cold-starts on its first call after idle (tens of seconds),
# and a short timeout would abort the spin-up. Mirrors openagent-infra (600s).
CODE_REQUEST_TIMEOUT=600
# Before the first task, send a throwaway tool-call probe and wait until the worker
# returns a real tool_call (warm + parser active), up to CODE_WARMUP_BUDGET seconds.
# Stops the first real task from eating the cold start. false = skip; no-op for
# Bedrock (empty CODE_API_BASE).
CODE_WARMUP=true
CODE_WARMUP_BUDGET=600
# Stream the primary model turn (specs/0043). Off (default) = a single non-streaming call, byte-identical
# to before. On = stream=True + include_usage, reassembled into the same response the rest of the agent
# sees, so nothing downstream changes. Nice for a long-reasoning model (Inkling). warm_up and compaction
# summaries never stream. Depends on the provider emitting a terminal usage chunk for token accounting.
CODE_STREAM=false
# Show reasoning (Phase 64 / specs/0064), default OFF. Tee the model's separate reasoning channel to the
# console live - a dimmed "thinking" stream above the answer, so you can watch it reason. Needs CODE_STREAM
# on. TOP-LEVEL REPL only (subagents/eval never show their reasoning). Display-only - the reasoning is already
# captured in the trajectory either way. OFF -> nothing printed (byte-identical).
CODE_SHOW_REASONING=false

# How the model invokes tools:
#   native — OpenAI tool-calling. Default. Requires the serving stack to parse tool
#            calls; for gpt-oss on vLLM, launch the worker with
#            --enable-auto-tool-choice --tool-call-parser.
#   json   — prompt-based fallback, parsed by the harness. Works on ANY
#            OpenAI-compatible endpoint with no server tool-parser, but is brittle
#            for gpt-oss on multi-step tasks.
CODE_TOOL_MODE=native

# --- AWS Bedrock only (the TEACHER profile above) ----------------------------
# Used when CODE_MODEL starts with `bedrock/`. Needs the [bedrock] extra
# (pip install -e ".[bedrock]"  -> boto3) and Bedrock model access enabled in the
# region. Prefer an IAM role / SSO over static keys when you can; otherwise set:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION_NAME=us-west-2


# -----------------------------------------------------------------------------
# Agent loop                                                      (src/config.py)
# -----------------------------------------------------------------------------

# Directory the agent reads/edits. Locally defaults to the current directory;
# the Docker image sets this to /workspace (the mounted repo) automatically.
# Point it at a REAL repo — running against an empty directory yields a
# "no_action" run with nothing to edit.
# CODE_WORKSPACE=/path/to/your/repo

# Hard cap on model<->tool iterations (round-trips) per task — a STEP is not a token.
# A broad "review the repo" reads ~one file per step, so set this generously; on
# hitting the cap the agent spends one final turn synthesizing what it found rather
# than returning nothing. 50 suits a large-context model; lower it for a tiny one.
CODE_MAX_STEPS=50

# Auto-approve write/edit/run_command (true), or confirm each interactively
# (false). Interactive confirmation only works on a local TTY, not in compose.
# Back-compat shim: when CODE_PERMISSION_MODE is unset, true -> bypass, false -> default.
CODE_AUTO_APPROVE=true

# --- permissions (Phase 4 #6) — see specs/0001-permissions.md ---
# How much to auto-approve. Unset = derived from CODE_AUTO_APPROVE (above).
#   default     - mutating tools need approval (prompt if a human is present, else block)
#   acceptEdits - auto-approve write_file/edit_file; run_command still gated
#   plan        - read-only: every mutating tool is blocked
#   bypass      - auto-approve everything (today's default)
#   propose     - investigate read-only, then propose a change-manifest the user approves before edits
CODE_PERMISSION_MODE=
# Path to a JSON file of allow/ask/deny rules (see permissions.json.example). deny
# ALWAYS wins, even under bypass. Matchers: run_command(rm:*), edit_file(src/**).
CODE_PERMISSIONS_CONFIG=
# Extra dirs the file tools may touch beyond the workspace (os.pathsep- or comma-
# separated). The workspace is always allowed; this only widens the fence.
CODE_ADD_DIRS=

# --- propose mode (Phase 22 / specs/0022) ---
# Before a substantive change the agent PROPOSES a change-manifest (the files it will add/move/update/
# delete + why) that you approve ONCE, then it executes exactly that - so execution never hits a runtime
# deny. `--mode propose` (or CODE_PERMISSION_MODE=propose) makes it mandatory AND turns this flag on; in
# the OTHER modes this flag offers the same propose_changes tool for the agent to elect on a broad or
# destructive change (asking a single [y/N]). Off by default -> the tool isn't offered (byte-identical).
CODE_PROPOSE=false
# Propose follow-through (specs/0048) — after you approve a plan, keep working the same session without
# re-proposing. All default OFF (byte-identical to specs/0022; an approval never leaks past its turn); each
# is consulted ONLY after the first approval this session, and the deny-rules + workspace fence ALWAYS win.
#   RUN_AFTER_APPROVAL    (c): a mutating run_command (run/test what you built) prompts instead of being
#                              blanket-denied. Recommended baseline.
#   EXTEND_AFTER_APPROVAL (b): an off-manifest file edit prompts per-edit (extend files without a new plan).
#   PERSIST_APPROVAL      (a): the approved files stay writable with NO further prompt all session
#                              ("scoped bypass" — deny + fence still hold, but weaker than propose's
#                              guarantee). Supersedes (b)/(c) while on.
CODE_PROPOSE_RUN_AFTER_APPROVAL=false
CODE_PROPOSE_EXTEND_AFTER_APPROVAL=false
CODE_PROPOSE_PERSIST_APPROVAL=false
# Propose first-approval backstop (Phase 52 / specs/0052), default OFF. The three relaxations above only take
# effect AFTER a manifest is approved (ctx.propose_graduated), which needs the model to call propose_changes -
# a weak model never does, so propose dead-ends read-only with no way for you to approve. When ON: a mutating
# op denied in the investigate phase becomes an interactive "approve this action and unlock the session? [y/N]"
# (a yes graduates the session + allows the op), the REPL gains /approve to unlock directly, and a read-only
# denial fed back to the model coaches it to call propose_changes. Under deny-rules + the fence always. OFF ->
# no prompt, no graduation path, the deny stands (byte-identical to specs/0022/0048).
CODE_PROPOSE_AUTOPLAN=false

# --- completion & manifest honesty (Phase 26 / specs/0026) ---
# Two independent, default-OFF nets that stop a "done" claim from being recorded when nothing backed it:
#   CODE_VERIFY_MANIFEST: reconcile an APPROVED propose-mode manifest against the mutation ledger - an item
#     that never landed re-prompts (a partial apply, e.g. a dropped apply_patch, is caught not masked), the
#     manifest record logs whether it fully `applied` (a partial one is dropped from SFT), and a dropped
#     (empty) native finish is labelled 'no_output' instead of a clean completion.
#   CODE_VERIFY_MUTATION_CLAIMS: DEPRECATED (specs/0032). A deterministic net that flags a completed
#     file-mutation claim ("I copied the folder") on an EMPTY ledger. It is the one check anchored on PROSE,
#     not a declared structured artifact (a live smoke test caught it false-flagging descriptive prose).
#     Superseded by the structured declared-done family (completion/manifest/acceptance/goal); leave it OFF
#     and prefer CODE_VERIFY_MANIFEST. Kept only as an opt-in backstop.
# Both OFF -> byte-identical (no reconciliation, no `applied` field, the dropped finish stays 'final').
CODE_VERIFY_MANIFEST=false
CODE_VERIFY_MUTATION_CLAIMS=false
# Runtime-done honesty gate (Phase 53 / specs/0053), default OFF. The unverified-success net only knows
# test/build "pass/green/clean" language, so a "Done - plumbing fixed / the app is serving" claim sailed
# through while `curl :8080` was returning connection-refused. When ON: a deterministic net flags a
# "service/app/server/container is up / serving / plumbed" claim when NO health-check (curl / http-get / port
# probe) returned ok this turn (ctx._runtime_ok); per-sentence, hedge- AND negation-guarded so an honest
# "it's not up yet" / "run curl to confirm" is never flagged. OFF -> the net never runs (byte-identical).
CODE_VERIFY_RUNTIME_DONE=false

# --- verified completion (Phase 6 / specs/0007) ---
# When on, the agent can't report a task DONE while it has update_plan steps marked completed
# whose named file shows no real change — the harness challenges the mismatch up to N times,
# then records an honest 'unverified_completion' outcome (never trained on). Stops the model
# reporting work it didn't do (a review once claimed "all files updated" while deleting nothing).
# Off restores the old accept-on-first-final behavior.
CODE_VERIFY_COMPLETION=true
CODE_VERIFY_COMPLETION_RETRIES=2

# --- grounding gate (Phase 10 / specs/0010) ---
# After verified completion accepts a "done", check the closing answer's CLAIMS are grounded in the
# sources the agent cited. Tier 1 (always on) flags a cited path that doesn't exist. Tier 2 (SEMANTIC)
# spawns a captured verifier subagent that re-reads the sources and flags factual claims they don't
# support — the honest-but-wrong class (a real file, the wrong facts) that completion can't see. A
# grounding failure is challenged up to N times, then recorded as an honest 'ungrounded_completion'.
# Tier 2 is on by default: it is the more agentic check, and each verifier is a captured trajectory.
CODE_VERIFY_GROUNDING=true
CODE_VERIFY_GROUNDING_RETRIES=2
CODE_VERIFY_GROUNDING_SEMANTIC=true
# Reasoning effort for the Tier-2 verifier subagent ONLY, independent of the coding agent's
# CODE_REASONING_EFFORT — run the judge cheap (low) while the agent stays high. Empty = inherit the
# global; else low|medium|high. Calibrate the right value with scripts/calibrate_grounding.py
# (low is calibrated-sufficient for the canonical honest-but-wrong / init.sql case).
CODE_GROUNDING_EFFORT=low
# Grounding path accuracy (Phase 27 / specs/0027), default OFF. When on: the deterministic present-path
# existence check ALSO runs in semantic mode (the Tier-2 verifier is fail-open on a phantom PRESENT path -
# a described-but-never-written Dockerfile); extension-less well-known files (Dockerfile / Makefile / ...)
# are existence-checked; and the verifier subagent is told the granted reference dirs so it can read a cited
# granted-dir file by absolute path. OFF -> byte-identical (existence check stays semantic-off-only).
CODE_VERIFY_GROUNDING_PATHS=false
# Greenfield grounding guard (specs\0042), default OFF. On an EMPTY project dir every path the closing
# answer cites is a file it PROPOSES to create, not a present-state claim, so the path-existence checks
# (present-path + the Tier-2 path verifier) flag each as a phantom (the Centpilot scaffold run: 42 then 15
# false "unbacked" flags on an empty workspace). When on, grounding skips ONLY the path checks while the
# workspace has no reviewable files; the success-claim / absence / web nets and every populated-repo run are
# untouched. OFF -> byte-identical (the check is never even reached).
CODE_GROUND_SKIP_GREENFIELD=false
# How many reviewable source files a workspace may hold and still count as "greenfield" for the flag above
# (specs/0047). 0 (default) = strictly empty, byte-identical to specs/0042. Raise it (e.g. 15) so a small
# EARLY-STAGE scaffold is treated as greenfield too — stops grounding from flagging a build session's own
# not-yet-real files turn after turn (the Inkling Centpilot run re-flagged its 11 stub files repeatedly).
# Only consulted when CODE_GROUND_SKIP_GREENFIELD is on.
CODE_GROUND_GREENFIELD_MAX=0

# Narration-stall guard (specs/0067), default OFF. A weak model that finished but won't END the turn fills dead
# air with side-effect-free `run_command('Write-Output "Status…"')` — dozens in a row, burning steps and
# poisoning the corpus. When on, N consecutive narration-ONLY steps trip a bounded nudge to finalize, then an
# honest 'narration_stall' outcome. A read / pipe / redirect / chain never trips it. MAX=consecutive steps to
# tolerate (min 2), RETRIES=nudges before ending.
CODE_GUARD_NARRATION_STALL=false
CODE_NARRATION_STALL_MAX=3
CODE_NARRATION_STALL_RETRIES=1

# Subagent propose-deadlock fix + no-progress stall breaker (specs/0084), default OFF -> byte-identical.
# SUBAGENT_NO_PROPOSE: a spawned child (grounding verifier / guardian / any subagent) must NEVER inherit PROPOSE
# mode — a depth>0 child can neither mutate (read-only until approved) NOR approve (propose_changes is
# top-level-only), a guaranteed deadlock that burned whole turns live. When on, such a child gets the honest
# plan-mode read-only view (stop and report up) and the auto-spawned verifiers run read-only in every mode.
# STALL_MAX: the general no-progress backstop the narrow narration guard can't be. A step makes NO progress when
# none of its calls did NOVEL successful real work (all denied / failed / pure-narration / a DUPLICATE of one
# already run this turn); unlike the narration/denial counters it does NOT reset on an interleaved allowed-but-
# useless call. N in a row -> one nudge then an honest 'stall'. 0 = off; a good live value is ~8.
CODE_SUBAGENT_NO_PROPOSE=false
CODE_STALL_MAX=0
CODE_STALL_RETRIES=1

# Narration-as-final (specs/0085), default OFF -> byte-identical. The ROOT fix for the narration loop. In native
# tool mode a turn with any tool call has final=None, so a weak model that "replies" by printing —
# run_command(Write-Output "answer") — is run as a no-op and loops, never emitting a clean finish. When on, a
# step whose ONLY calls are pure-narration prints ENDS the turn with the printed text as the final answer, the
# first time (no loop, no bandaid). Recommended ON for a weak model (e.g. Inkling-Small) that reply-prints.
CODE_NARRATION_AS_FINAL=false

# Print tool activity to stdout as the agent works.
CODE_VERBOSE=true

# --- session log (src/logsetup.py) ---
# A readable .log file per run (tool calls + results, retries, errors, outcomes) — built to
# be handed off for review: run on any repo, then give logs/<session>.log to a reviewer
# (or paste it to Claude) to debug the run. Separate from the trajectory (training data).
# CODE_LOG_DIR="" disables it; CODE_LOG_LEVEL=DEBUG for maximum detail.
CODE_LOG_DIR=logs
CODE_LOG_LEVEL=INFO

# --- context compaction (Phase 4) ---
# When the live context exceeds this estimated-token budget, older turns are
# summarized so the model keeps working in a smaller window. This shrinks only
# what the MODEL SEES — the full raw history is still logged (see ROADMAP
# "capture vs context"). 0 disables compaction. Set low (e.g. 800) to force it
# for testing.
CODE_COMPACT_AT_TOKENS=12000
# How many of the most-recent messages to keep verbatim (never summarized).
CODE_COMPACT_KEEP_RECENT=6
# Cap on a SINGLE message's content in the LIVE context (full text still logged raw to the
# trajectory). Stops one giant tool result — a huge file read, a long subagent return — from
# dominating the window and defeating compaction. ~48k chars ≈ 12k tokens. 0 disables.
CODE_MAX_MESSAGE_CHARS=48000
# The model's HARD context window (Phase 34 / specs/0034). Unlike CODE_COMPACT_AT_TOKENS above (a SOFT
# compaction TRIGGER), this is the true ceiling the SENT context must never exceed — the harness compacts
# UNDER it and bounds each summarize call below it, so resuming a long session can't overflow the window.
# Inkling-Small on Tinker is 262144 (256k); gpt-oss-120b is 131072. Set it to your model's real window. The
# internal compaction/summarize budgets are derived from this with headroom (no extra flags). specs/0045: the
# value may be the sentinel `auto`, which resolves the real window at startup (litellm model-info, then the
# OpenAI-compatible /models context_length, else the 131072 fallback). NOTE: on Tinker, `auto` currently
# fails - Cloudflare 1010-blocks the raw /models probe (specs/0054) - so PIN the int here (262144), don't rely
# on auto. Prefer pinning an explicit int once you know the number regardless.
CODE_MODEL_MAX_TOKENS=262144
# Optional per-request OUTPUT cap (specs/0045), independent of the window above. Empty / 0 (default) = send
# NO max_tokens (byte-identical). A positive int = fixed cap. `auto` = window - prompt_estimate -
# CODE_OUTPUT_MARGIN_TOKENS, floored so a big prompt never yields a non-positive cap. The margin must cover
# the model's OUTPUT incl. reasoning tokens (Inkling's reasoning_content is output-side), so size it against
# your CODE_REASONING_VALUE (specs/0044).
CODE_MODEL_MAX_OUTPUT_TOKENS=
CODE_OUTPUT_MARGIN_TOKENS=4096

# --- subagents (Phase 4) ---
# How deep spawn_agent can nest. 0 = disabled, 1 = one level (top-level agent may
# spawn, its children may not), 2 = children may spawn too, etc. Each subagent runs
# in isolation and is captured as its own (linked) trajectory. 2 lets a per-folder
# child decompose a large folder one level further (whole-project review as a tree).
CODE_MAX_SUBAGENT_DEPTH=2
# How many children ONE agent may spawn (breadth). Depth alone doesn't bound cost —
# an agent told to "decompose" could otherwise spawn unboundedly. Caps the fan-out.
CODE_MAX_SUBAGENT_FANOUT=8
# Fan-out cap for the review_repo orchestrator (whole-project review). Higher than the
# ad-hoc spawn cap because a repo review wants EVERY top-level area covered, and each
# child is bounded and returns only a short summary.
CODE_MAX_REVIEW_AREAS=16

# --- workflows (Phase 38 / specs/0038) - OPT-IN ---
# A synchronous MULTI-PHASE fan-out+reduce engine (the run_workflow tool): the generalization of review_repo
# to N ordered phases the model authors, each phase fanning out captured subagents and reducing to a digest
# that feeds the next. Off by default -> run_workflow isn't offered and the system prompt is unchanged.
CODE_WORKFLOWS=false
# Caps the pipeline length; each phase fans out up to CODE_MAX_SUBAGENT_FANOUT children, so the worst case is
# PHASES * FANOUT captured subagents. A distinct cap from CODE_MAX_REVIEW_AREAS.
CODE_MAX_WORKFLOW_PHASES=5
# Bounded PARALLEL fan-out (Phase 39 / specs/0039). How many fan-out children run at once: 1 = serial
# (byte-identical to today); N>1 = up to N concurrently, applied to run_workflow, review_repo AND run_skill.
# Parallel children run READ-ONLY (writes/edits/deletes denied) so they can't race the filesystem — a
# workflow that WRITES must run serial (=1). Clamped to [1, CODE_MAX_REVIEW_AREAS].
CODE_WORKFLOW_CONCURRENCY=1
# Async background runtime (Phase 40 / specs/0040), REPL-ONLY, OPT-IN. When on, run_workflow can SUBMIT a
# workflow to run as a background SUBPROCESS and return a task-id immediately; the REPL drains a completion
# banner + /tasks + /result <id> (pull the result into your next message). Background workers are read-only.
# Off -> run_workflow runs inline exactly as today. CODE_MAX_BACKGROUND_TASKS caps concurrent background tasks.
CODE_WORKFLOWS_ASYNC=false
CODE_MAX_BACKGROUND_TASKS=3

# --- external tools (Phase 4 tool breadth) — OPT-IN egress ---
# Master switch for the web tools. OFF by default to preserve data sovereignty:
# web_fetch / web_search send data OFF this machine. Set true to allow them.
CODE_ENABLE_WEB=false
# Which web_search provider (Phase 24 / specs/0024):
#   generic — BYO endpoint at CODE_SEARCH_URL (POST {"query": ...}); the DEFAULT (unchanged behavior)
#   tavily  — RECOMMENDED hosted, LLM-optimized: a synthesized answer + ranked sources.
#             Set CODE_SEARCH_KEY to your tvly-... key (get one at tavily.com):
#               CODE_SEARCH_PROVIDER=tavily
#               CODE_SEARCH_KEY=tvly-...
#   searxng — self-hosted metasearch, the DATA-SOVEREIGN path (the query leaves only YOUR infra, unlike
#             tavily's hosted egress); run your own SearXNG and point CODE_SEARCH_URL at its /search
#   brave   — Brave Search API (CODE_SEARCH_KEY is the subscription token)
#   module:func — a dotted path to your own adapter (query, max_results) -> {results, answer, error}
CODE_SEARCH_PROVIDER=generic
# Endpoint for the generic / searxng providers. Leave empty and that provider reports "not configured".
CODE_SEARCH_URL=
# Provider credential: tavily API key / brave token, or an optional Bearer token for the generic endpoint.
CODE_SEARCH_KEY=
# How many results web_search returns (default 5).
CODE_SEARCH_MAX_RESULTS=5

# Connect MCP servers (stdio) listed in this JSON file — their tools appear as
# mcp__<server>__<tool>. Unset = MCP off. See mcp.json.example. The server's
# runtime (node/npx, python, ...) must be installed where openagent-code runs.
# A server marked "web": true in that file (specs/0029, e.g. Tavily's MCP - which adds extract/crawl/
# research on top of native web_search) has its output routed through the SAME untrusted-content fence +
# grounding read-ledger as web_fetch/web_search. Tavily's server reads its key from TAVILY_API_KEY (distinct
# from CODE_SEARCH_KEY, which the native web_search provider uses) - set it in mcp.json's env or the process
# env. The real mcp.json is gitignored (it can carry that key).
CODE_MCP_CONFIG=

# --- cross-session memory (Phase 4 #7) ---
# OFF by default (opt-in): writes a notes file INTO the target repo, and stays off
# for eval so the harness is isolated. On = the `remember` tool is offered and the
# project memory file is loaded into the system prompt at the start of each session.
CODE_MEMORY=false
# Per-project memory file, resolved relative to the workspace.
CODE_MEMORY_FILE=.openagent/memory.md
# Cap on how much memory is loaded into context (keeps the system prompt bounded;
# the most-recent notes are kept).
CODE_MEMORY_MAX_CHARS=4000

# --- project todos (Phase 23 / specs/0023) ---
# OFF by default (opt-in): a persistent, per-project BACKLOG the agent maintains — the durable "what's still
# to do" on this repo, the structured sibling of memory. On = the `project_todos` tool is offered, and the
# backlog (a `- [ ]` / `- [~] / - [x]` checklist) is loaded into the system prompt AND shown at the start of
# each session. Distinct from update_plan (this task's verified steps); the agent promotes a backlog item
# into update_plan when it starts working it. Writes a checklist file INTO the repo, so off for eval.
CODE_PROJECT_TODOS=false
# Per-project todos file, resolved relative to the workspace.
CODE_PROJECT_TODOS_FILE=.openagent/todos.md
# Outer bound on how much of the backlog is injected into the prompt (capped by whole lines, so it never
# slices a checklist item; done items are excluded from the injection).
CODE_PROJECT_TODOS_MAX_CHARS=4000

# --- spec-first (Phase 25 / specs/0025) - OPT-IN ---
# OFF by default: for a substantive change the agent authors a persistent design+acceptance SPEC first
# (.openagent/specs/NNNN-slug.md - Goal / Acceptance checklist / Non-goals), gets it approved, implements
# against it, and CANNOT report done until every acceptance item is marked met. The active spec is loaded
# into the system prompt + shown at startup; a declined or unmet spec is dropped from SFT. Writes spec files
# INTO the repo, so off for eval.
CODE_SPEC_FIRST=false
# Per-project specs DIRECTORY, resolved relative to the workspace (co-located with memory.md / todos.md).
CODE_SPECS_DIR=.openagent/specs
# Outer bound on how much of the active spec is injected into the prompt (capped by whole lines).
CODE_SPECS_MAX_CHARS=8000
# How many times the acceptance gate re-prompts before recording an honest 'acceptance_unmet'.
CODE_SPEC_FIRST_RETRIES=2

# --- skills (specs/0008) ---
# Reusable, harness-orchestrated review workflows defined as SKILL.md files. The CODE default is off
# (opt-in) so a bare no-.env run stays lean; this example turns it ON — the recommended setup. On =
# the run_skill tool is offered; 'code-review' reviews the CURRENT git diff by concern (correctness /
# tests / breaking-changes), one captured subagent each, and returns one numbered report — which also
# multiplies the training corpus (N+1 trajectories per run). The skills dir SELF-LOCATES against the
# install root (like trajectories), so it works from any repo.
CODE_SKILLS=true
CODE_SKILLS_DIR=skills

# --- situational context (Phase 12 / specs/0012) — OPT-IN ---
# Inject a small per-turn block of the agent's REAL environment (cwd, OS, shell, date, granted dirs)
# as a refreshed, compaction-safe pin, so the model conditions on live state instead of confabulating
# the date / OS / branch. Near-zero cost, no decision surface; left OFF here until live-validated, then
# it is a safe flip to true. (specs/0035 fix C: the block is injected as a single pinned copy + a
# system-role trajectory capture, NOT a role:'user' turn adjacent to the task - which a live run treated
# as user input and bled into a user-typed path.)
CODE_SITUATIONAL_CONTEXT=false
# Additionally append a bounded git branch + status line (one `git` call per TURN, not per step). Only
# consulted when CODE_SITUATIONAL_CONTEXT is on; degrades cleanly (no line) on a non-repo / missing git.
CODE_SITUATIONAL_GIT=false
# Append PowerShell 5.1 command rules to the env block on Windows (specs/0046), default OFF. Stops a
# bash-trained model wasting turns on POSIX commands PS rejects: no `&&`/`||` (use `;`), `New-Item` not
# `mkdir -p`, `$null` not `/dev/null`, `curl.exe` for real curl. Needs CODE_SITUATIONAL_CONTEXT on; no-op
# off Windows. OFF -> env block byte-identical.
CODE_SHELL_HINTS=false
# Non-interactive shell (Phase 55 / specs/0055), default OFF. run_command's child inherits the REPL's stdin,
# so a command that READS stdin blocks forever - a live run HUNG when the model emitted a bare PowerShell
# `echo` (Write-Output with no arg prompts for input). When on, PowerShell gets -NonInteractive and the
# child's stdin is DEVNULL, so any stdin read fails fast instead of hanging. OFF -> prior argv + inherited
# stdin (byte-identical for every command that does not read stdin).
CODE_SHELL_NONINTERACTIVE=false
# Self-state in context (Phase 62 / specs/0062), default OFF. Append the agent's current REASONING EFFORT to
# the per-turn situational block (needs CODE_SITUATIONAL_CONTEXT), so when asked "what reasoning level are you
# at" it reports the real value (e.g. xhigh) instead of confabulating. The model id is deliberately NOT
# injected (specs/0061: never reveal the base model). OFF -> the block is byte-identical.
CODE_CONTEXT_SELF_STATE=false
# Working-directory prompt (Phase 30 / specs/0030), default OFF. Pins the ABSOLUTE workspace path in the
# DURABLE (never-compacted) system prompt, and teaches that a granted reference dir is a READ SOURCE while a
# copy/create DESTINATION is the workspace - so a "copy the .env over" write lands in the working dir, not
# back in the granted source (the log-observed slip). OFF -> the path isn't rendered and the granted-dirs
# note keeps its old text (byte-identical). Unlike CODE_SITUATIONAL_CONTEXT (a per-turn env block), this is
# a durable line that survives compaction.
CODE_WORKDIR_PROMPT=false

# Trusted user directories (Phase 35 / specs/0035), default OFF. Treat a directory the USER LITERALLY TYPED
# in a REPL message as an explicit READ grant (keyed off the user's own text, immune to the model re-typing
# it), and let request_dir AUTO-GRANT an existing dir under BYPASS at the top level with a human present
# (no [y/N]) instead of prompting. READ-ONLY by construction: grants land in a read_only_roots tier that
# MUTATING tools ignore (a write/delete/rename can never reach a read-granted dir). A denylist rejects
# drive/share roots + system/credential dirs even under bypass. Fixes a live session where a project the
# user named twice was never reviewed. OFF -> read_only_roots stays empty and request_dir is byte-identical.
CODE_TRUST_USER_DIRS=false

# Reply-shape precedence (Phase 41 / specs/0041), default OFF. Teach the agent that an explicit USER
# reply-shape/length instruction for THIS turn ("respond with only Yes", "one word", "just the list")
# OUTRANKS a tool's "synthesize now / write the full report" trailer, and that such an instruction is
# PER-TURN (does not bind later turns). Fixes a live session where "respond with only Yes" was overridden by
# a review digest, then a stale terseness bled into later turns. OFF -> prompt/pin/trailers byte-identical.
CODE_REPLY_SHAPE=false

# Prompt hygiene (Phase 51 / specs/0051), default OFF. One system-prompt note closing four small-model
# failure modes a live Inkling-Small run showed: (identity) your name/persona is a STYLE to embody SILENTLY,
# never announced or restated; (no arguing) if the user says you repeated / misread, ADJUST - don't rebut;
# (propose recovery) in propose mode call propose_changes before ANY edit OR state-changing command, and if
# denied read-only, propose it - don't retry the raw op; (service honesty) don't claim a service is up unless
# you actually reached it. Also fills the PowerShell 5.1 shell-hint gaps (head/tail -> Select-Object,
# `$?` -> `$LASTEXITCODE`, `tree` has no -Depth). OFF -> no note appended (byte-identical prompt).
CODE_PROMPT_HYGIENE=false

# --- edit-layer (Phase 13 / specs/0013) - OPT-IN ---
# CODE_EDIT_FUZZY: a SAFE fuzzy fallback UNDER exact-match edit_file. When the exact old_string isn't
# found, it locates the target (whitespace-insensitive, then most-similar chunk) and applies ONLY a
# unique, above-threshold match; any ambiguity refuses (no silent wrong-place edit). Off by default.
CODE_EDIT_FUZZY=false
# Similarity floor (0..1) for the fuzziest tier. Keep it conservative - a loose value is what would
# reintroduce the silent-corruption risk the exact-match design prevents.
CODE_EDIT_FUZZY_THRESHOLD=0.9
# CODE_APPLY_PATCH: offer the apply_patch tool - ONE envelope makes several file ops (Add/Update/Delete/
# Move) ATOMICALLY (all-or-nothing; on any parse/hunk error, nothing is written). Off by default.
CODE_APPLY_PATCH=false

# --- auto-verify (Phase 14 / specs/0014) - OPT-IN ---
# After the completion gate accepts a "done", run a check on just the TOUCHED files; on failure re-prompt
# to fix (bounded) then record an honest 'verify_failed_edits' (dropped from SFT). The command is an ARGV
# list (no shell -> no injection) and OPERATOR-configured (never model-controlled); default is a safe
# `python -m py_compile`. Off by default.
CODE_VERIFY_TOUCHED=false
CODE_VERIFY_TOUCHED_RETRIES=2
# JSON map of file-extension -> argv LIST, e.g. {".ts": ["node", "check.js", "{file}"]}; '{file}' is the
# touched path. Resolved against the install root. Empty = the built-in `.py -> py_compile` default only.
CODE_VERIFY_CMDS_CONFIG=
# Per-check subprocess timeout (seconds).
CODE_VERIFY_TIMEOUT=60
# Record each check's pass/fail as an objective reward label on the trajectory (the flywheel signal).
# Default on - harmless when CODE_VERIFY_TOUCHED is off (no checks run).
CODE_VERIFY_TOUCHED_LABEL=true

# --- execpolicy (Phase 16 / specs/0016) - OPT-IN ---
# Gate run_command on its PARSED segments (read-only / mutating / dangerous) instead of a raw prefix:
# a deny/ask/allow rule then matches ANY segment (the `rm` inside `cd x && rm y`), and a wholly
# read-only command (ls, git status) is allowed like a read tool. Off by default -> the prefix matcher
# is unchanged.
CODE_EXECPOLICY=false
# Self-preservation (specs/0050), default OFF. The agent runs as `python -m src`, so a NAME-based process
# kill (Stop-Process -Name python, taskkill /IM python*, pkill/killall python) terminates Arcus itself and
# aborts the run mid-task. On = hard-deny those in EVERY mode incl. bypass (like the deny rules + fence);
# kill-by-PID stays allowed (stop a test server by its PID). OFF -> byte-identical.
CODE_GUARD_SELF_KILL=false

# --- sandbox: FS confinement (Phase 17 / specs/0017) - OPT-IN ---
# Extend the workspace fence to run_command's WRITES: a command whose output redirect or write-command
# destination (cp/mv/tee/dd/Out-File/...) resolves OUTSIDE cwd + CODE_ADD_DIRS is REFUSED, so it can't
# write past the fence even under an allow rule / bypass. Off by default -> run_command is unchanged.
CODE_SANDBOX=false

# --- guardian (Phase 19 / specs/0019) - OPT-IN ---
# A fail-CLOSED LLM approval reviewer for the ASK tier. HEADLESS-ONLY: when NO human is present (eval /
# Docker / one-shot), a tool that hits `ask` is decided by a CAPTURED reviewer subagent (approve/deny) so
# an unattended run can proceed on a REVIEWED action instead of just blocking. When a human IS present
# (interactive REPL) you still get the [y/N] prompt - the guardian does not fire. Any error / ambiguous
# verdict DENIES. Governs the ask tier ONLY (never allow/deny/read-only). An identical command is reviewed
# once per turn. Off by default -> the human-prompt path is unchanged.
CODE_GUARDIAN=false
# Interactive guardian (Phase 57 / specs/0057), default OFF. Let the guardian ALSO adjudicate in the REPL
# (not just headless): it AUTO-APPROVES the clearly-safe, on-request ask-tier calls (a curl health-check,
# node -c, a build step) so the agent flows without a [y/N] for every probe, and defers anything it will NOT
# approve to the human [y/N] (you stay the backstop). Deny-rules + fence + mass-destruction cap + self-kill
# guard still apply. Each ask-tier call spawns a reviewer (a model call) - set CODE_GUARDIAN_EFFORT=low to
# keep it snappy; read-only commands still auto-allow with no review. Needs CODE_GUARDIAN on. OFF ->
# headless-only (byte-identical to specs/0019).
CODE_GUARDIAN_INTERACTIVE=false
# Reasoning effort for the reviewer subagent (low|medium|high|...); empty = inherit the global default.
CODE_GUARDIAN_EFFORT=
# Mass-destruction backstop: a HARD ceiling on DESTRUCTIVE ops (delete / move / dangerous command) the
# guardian may auto-approve in ONE turn. The reviewer is aggregate-blind (one call at a time), so a bulk
# delete decomposed into single deletes would be rubber-stamped; past this many, the next is DENIED
# ("escalate to a human") regardless of the verdict. Raise it for a bigger unattended sweep. 0 disables.
CODE_GUARDIAN_MAX_DESTRUCTIVE=5

# --- hooks (Phase 15 / specs/0015) - OPT-IN ---
# Opt-in, FAIL-OPEN lifecycle scripts around every tool call. A PreToolUse hook can DENY any tool (a
# policy about the EFFECT, not the tool name - closes "deny is tool-scoped"); a PermissionRequest hook
# can approve/deny an ask-tier call (deterministic sibling of the guardian, headless-only); a PostToolUse
# hook observes the result (telemetry / trajectory annotation). A missing/crashing/slow/non-JSON hook is
# IGNORED - hooks only ADD restrictions + observability, never weaken the deny rules + fence + sandbox.
# Off by default -> decide()/the tool loop never consult hooks (byte-identical).
CODE_HOOKS=false
# Path to a JSON manifest of PreToolUse/PostToolUse/PermissionRequest commands (see hooks.json.example).
CODE_HOOKS_CONFIG=

# --- goal loop (Phase 20 / specs/0020) - OPT-IN ---
# Stop being the loop. The agent calls `pursue` with an objective and a MACHINE-CHECKABLE bar, and the
# HARNESS iterates - do work, run the bar, feed the REAL output back - until the bar passes or the budget
# runs out. The model NEVER decides "done": the bar's exit code does. A runnable bar is REQUIRED, which is
# also the filter for "is this loop-shaped?" - no bar, no loop. Unlike CODE_VERIFY_CMDS_CONFIG (operator-
# configured), this bar is MODEL-proposed, so it is argv-only (run shell=False, never a shell string),
# entry-filtered (no destructive bar, no shell/interpreter), and permission-gated like any command. A
# budget exhausted without the bar passing records an honest `goal_unmet`, which is dropped from the SFT
# corpus (thrash is never a training target). Off by default -> `pursue` isn't even offered to the model.
CODE_GOAL_LOOP=false
# Hard ceiling on bar attempts per turn, whatever the model asks for. The mass-destruction cap counts
# DISTINCT targets, so it does NOT bound a bar re-running - this is the only thing that does.
CODE_GOAL_MAX_ITERATIONS=3
# Steps held in reserve: when max_steps runs out the loop would fall through to the synthesis path and
# report 'max_steps' instead of the honest 'goal_unmet'. The gate stops re-prompting this close to it.
CODE_GOAL_STEP_HEADROOM=6
# Seconds one bar run may take before it is killed (a hung bar must not hang the loop).
CODE_GOAL_TIMEOUT=120
# OPTIONAL operator allowlist: a JSON file of permitted bar argv lists, e.g. [["npm","test"],["pytest"]].
# Empty = no allowlist (the entry filter + permission gate still apply). Set it to restrict the loop to
# bars YOU sanctioned - the strictest answer to "the model proposes the command that gets re-run".
CODE_GOAL_BARS_CONFIG=

# --- adaptive reasoning effort (Phase 21 / specs/0021) - OPT-IN ---
# Match how hard the model thinks to how hard the task is, instead of a fixed level. The agent can raise
# its own effort (the `escalate_effort` tool) and the harness auto-raises it when the run is STRUGGLING
# (repeated tool failures, gate re-prompts, a goal bar that keeps failing). Escalate-only, capped, reset
# each turn. Off by default -> effort is byte-identical to today (the tool isn't even offered).
CODE_ADAPTIVE_EFFORT=false
# Which policy decides: 'off' (never escalate) | 'reactive' (the deterministic default) | 'online' (the
# opt-in self-learning policy in src/effort_online.py) | a dotted 'module:Class' you wrote. Bad -> reactive.
CODE_EFFORT_POLICY=reactive
# The floor to ladder from when the base effort is unset, and the hard ceiling (low|medium|high).
CODE_EFFORT_FLOOR=medium
CODE_EFFORT_MAX=high
# Struggle score at which the harness auto-escalates one rung (a single flaky retry shouldn't jump).
CODE_EFFORT_THRESHOLD=2
# OPTIONAL state file for the 'online' learner's persisted per-task stats. Empty = in-memory only.
CODE_EFFORT_STATE=


# -----------------------------------------------------------------------------
# Training flywheel                                               (src/config.py)
# -----------------------------------------------------------------------------

# Where session JSONL is written. Relative paths resolve against CODE_WORKSPACE,
# so trajectories land in the repo being worked on and persist on the host.
CODE_TRAJECTORY_DIR=trajectories
# Trajectory PII/secret scrubbing (Phase 59 / specs/0059), default OFF. The trajectory captures everything the
# agent reads/writes verbatim, so a pasted budget or an authed page puts financials + a session token straight
# into the training corpus. When on, each record is scrubbed at the single write choke point before it hits
# disk: SECRETS (private keys, JWTs, provider API keys, bearer/CSRF/session tokens, emails) and FINANCIAL PII
# (currency amounts, account IDs, cards/SSNs) -> `[redacted:<kind>]`. Only the PERSISTED copy is scrubbed - the
# live context the agent works from this turn is untouched. OFF -> byte-identical (scrub never runs).
CODE_SCRUB_TRAJECTORY=false

# Mandated verification = the objective reward signal. The command that proves
# a change works in the TARGET repo, e.g. "pytest -q" or "npm test". Empty skips
# verification (no reward label is recorded for the session).
CODE_VERIFY_COMMAND=

# Which captured view train/convert.py flattens into SFT rows:
#   raw     — the full uncompacted history, every turn (the source of truth). Default.
#   as_sent — what the model actually saw (post-compaction); train the model to
#             work well FROM compacted context.
CODE_SFT_VIEW=raw

# --- corpus curation (Phase 11 / specs/0011) ---
# Offline batch pass (train/curate.py, run via train/convert.py) that flags PHANTOM CITATIONS — a
# closing answer referencing a file the run never opened. Deterministic, no model (the semantic
# honest-but-wrong class is caught live by the grounding gate). CODE default off; this example turns
# it ON — flag mode (below) only TAGS rows, never drops, so it is safe to leave on.
CODE_CURATE=true
# flag    — tag every SFT row with the grounding verdict; never shrink the corpus (default).
# exclude — drop ungrounded sessions from the SFT set, counted in report.json's dropped ledger.
CODE_CURATE_MODE=flag


# -----------------------------------------------------------------------------
# SageMaker training (cloud LoRA-SFT)                       (train/launch_sm.py)
# -----------------------------------------------------------------------------
#
# Train the student on AWS SageMaker instead of a local GPU / Docker — Script Mode on
# the prebuilt PyTorch container (specs/0006). These are read by the LAUNCHER
# (train/launch_sm.py), NOT the agent (src/config.py). Needs the [sagemaker] extra:
#   pip install -e ".[sagemaker]"
#
# IMPORTANT — SageMaker uses REAL IAM credentials, NOT the Bedrock bearer token. Run
# `aws configure` with an IAM access key (AKIA...) + secret in this region. The Bedrock
# teacher's bearer token is a SEPARATE auth for a SEPARATE service; don't conflate them
# (same AWS account, different credentials).
#
# CODE_SM_ROLE    - the SageMaker execution role ARN (SageMakerFullAccess + S3 access). REQUIRED.
# CODE_SM_BUCKET  - OPTIONAL. Unset uses SageMaker's DEFAULT bucket. The tiny dataset is bundled
#                   into source_dir, so there's no data bucket to create and no separate upload.
# AWS_REGION      - region for the training job.
# HF_TOKEN        - forwarded to the job ONLY if set (private base models); never stored.
# CODE_SM_ROLE=arn:aws:iam::<account-id>:role/OpenAgentSageMakerRole
# AWS_REGION=us-east-1
# HF_TOKEN=

# Secret-exfil hardening (specs/0078), all default OFF. ENV_SCRUB: spawn run_command children with an
# allowlisted env (drops CODE_* + api_key/secret/token/password/aws_/openai_ vars) so a child can't exfiltrate
# the model key; ENV_PASSLIST re-admits named vars a toolchain needs (never CODE_*). SCRUB_OUTPUT: redact
# secrets in live run_command output before the model sees it. SECRET_DENY_READ: deny read_file of .env/keys
# (SECRET_PATH_GLOBS) and skip them in grep/glob/tree.
CODE_ENV_SCRUB=false
CODE_ENV_PASSLIST=
CODE_SCRUB_OUTPUT=false
CODE_SECRET_DENY_READ=false

# Net-fence / SSRF guard (specs/0079), default OFF. web_fetch refuses a URL (or any redirect hop) whose host
# resolves to a non-public address (loopback/RFC1918/169.254 metadata/CGNAT/ULA), fail-closed on unresolvable.
CODE_NETFENCE=false

# Permission-policy hardening (specs/0080), default OFF. GUARDIAN_MAX_DENIALS: abort a turn after N consecutive
# DENIED tool calls (a prompt-injected denial loop) — 0 = off. PROTECT_PATHS: deny WRITES to .git internals and
# .env by default (a user's own rules still win).
CODE_GUARDIAN_MAX_DENIALS=0
CODE_PROTECT_PATHS=false

# Host-executable path pinning (specs/0081), default OFF (empty). Pin an exe basename to absolute path(s) so a
# planted same-named binary can't forge an allow rule; on an allow match the exe must resolve to a pinned path
# else it's downgraded to ask.  Format: git=C:/Program Files/Git/bin/git.exe;python=C:/Python/python.exe
CODE_EXEC_HOST_PIN=

# Secrets at rest (specs/0082), Windows, all default OFF. LOCK_SECRETS: at startup icacls-lock LOCK_SECRETS_PATHS
# (comma-separated, default .env) to owner-only — the Windows chmod 0600. SECRETS_VAULT: at startup load a
# DPAPI-encrypted vault (SECRETS_VAULT_PATH, default <install>/secrets.dat) into the env (setdefault), so the
# model key need not sit in plaintext .env. Off Windows / no ctypes -> DPAPI unavailable, feature simply off.
CODE_LOCK_SECRETS=false
CODE_LOCK_SECRETS_PATHS=.env
CODE_SECRETS_VAULT=false
CODE_SECRETS_VAULT_PATH=

# OS sandbox (specs/0083), Windows, all default OFF. The one KERNEL boundary. SANDBOX_SPAWN: run_command children
# spawn under a RESTRICTED TOKEN (privileges dropped, de-elevated) inside a JOB OBJECT (kill-on-close + caps) when
# the host supports it (a real probe decides; it never fakes confinement). SANDBOX_REQUIRED: if a command would be
# sandboxed but can't be, REFUSE it (fail-closed) instead of running unconfined. REQUIRE_SANDBOX_FOR_AUTO: a
# mutating run_command auto-approves only if it'll actually be sandboxed, else downgrades to ask. JOB caps:
# SANDBOX_JOB_MEM_MB (per-process commit cap MB, 0=none), SANDBOX_JOB_MAX_PROCS (0=none). WRITE_RESTRICTED adds the
# stricter write-SID token flag (needs the workspace granted to a restricting SID or writes fail — advanced).
CODE_SANDBOX_SPAWN=false
CODE_SANDBOX_REQUIRED=false
CODE_REQUIRE_SANDBOX_FOR_AUTO=false
CODE_SANDBOX_JOB_MEM_MB=0
CODE_SANDBOX_JOB_MAX_PROCS=0
CODE_SANDBOX_WRITE_RESTRICTED=false
